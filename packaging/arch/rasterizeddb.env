# RasterizedDB service settings, read by rasterizeddb.service.

# Password of the role `rasterized`, used by both the PostgreSQL protocol
# (port 5432) and the native protocol (port 61170). The service refuses to
# start while it is empty: an empty password would leave the native protocol
# open, without a login, to every local user.
RASTERIZEDDB_PG_PASSWORD=

# Further server flags (`rasterizeddb --help` lists them). By default both
# protocols listen on localhost only; to accept other machines:
#   RASTERIZEDDB_ARGS=--pg-addr 0.0.0.0 --rdb-addr 0.0.0.0
RASTERIZEDDB_ARGS=
